cmake_minimum_required(VERSION 3.19)

if(NOT DEFINED SOURCE_PORT OR NOT DEFINED DESTINATION_PORT)
    message(FATAL_ERROR "SOURCE_PORT and DESTINATION_PORT are required")
endif()

# GTK and its dynamically loaded image/theme modules must use the same GLib.
# Keep the pinned wxWidgets port, using Ubuntu's GTK3 and Cairo dependencies.
file(READ "${SOURCE_PORT}/vcpkg.json" manifest)
foreach(system_dependency IN ITEMS gtk3 cairo)
    string(JSON count LENGTH "${manifest}" dependencies)
    math(EXPR last "${count} - 1")
    set(found FALSE)
    foreach(index RANGE ${last} 0 -1)
        string(JSON type TYPE "${manifest}" dependencies ${index})
        if(type STREQUAL "OBJECT")
            string(JSON name GET "${manifest}" dependencies ${index} name)
            if(name STREQUAL system_dependency)
                string(JSON manifest REMOVE "${manifest}" dependencies ${index})
                set(found TRUE)
            endif()
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "The pinned wxWidgets port no longer declares ${system_dependency}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION_PORT}")
file(COPY "${SOURCE_PORT}/" DESTINATION "${DESTINATION_PORT}")
file(WRITE "${DESTINATION_PORT}/vcpkg.json" "${manifest}\n")
message(STATUS "wxWidgets: pinned port with system GTK3/Cairo")
